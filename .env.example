GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
TOP_K=8
RERANK_K=5
MIN_EVIDENCE_SCORE=0.18
# Local-only default. Set AUTH_MODE=supabase_jwt and APP_ENV=production only after completing setup and live tests.
AUTH_MODE=demo
APP_ENV=development
MAX_UPLOAD_BYTES=20971520
CORS_ALLOWED_ORIGINS=http://localhost:8501
